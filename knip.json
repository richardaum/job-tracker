{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": [],
  "ignoreBinaries": ["pm2"],
  "ignoreDependencies": [],
  "ignoreIssues": {
    "apps/web/src/gql/**": ["exports", "types", "files", "enumMembers"],
    "apps/extension/src/gql/**": ["exports", "types", "files", "enumMembers"]
  },
  "workspaces": {
    "apps/api": { "ignore": ["src/database/migrations/archive/**/*", "scripts/**/*", "src/generate-schema.ts"] },
    "apps/web": {
      "ignore": ["public/pdf.worker.min.mjs"],
      "ignoreDependencies": ["tailwindcss", "@rsdoctor/cli", "@rsdoctor/webpack-plugin"]
    },
    "apps/extension": {
      "ignoreDependencies": ["tailwindcss", "@graphql-codegen/typescript", "@graphql-codegen/typescript-operations"]
    },
    "packages/ui": {
      "ignore": ["vitest.shims.d.ts"],
      "ignoreDependencies": ["@vitejs/plugin-react", "@storybook/test-runner", "eslint-plugin-storybook"]
    }
  }
}
