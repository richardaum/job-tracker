{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": ["ecosystem.config.cjs"],
  "ignoreBinaries": ["pm2"],
  "ignoreDependencies": ["dotenv"],
  "workspaces": {
    "apps/api": {
      "ignore": ["src/database/migrations/archive/**/*", "scripts/**/*"]
    },
    "apps/web": {
      "ignore": [
        "src/gql/gql.ts",
        "src/gql/index.ts",
        "src/gql/fragment-masking.ts",
        "public/pdf.worker.min.mjs"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "@rsdoctor/cli",
        "@rsdoctor/webpack-plugin"
      ]
    },
    "apps/extension": {
      "ignore": [
        "src/gql/fragment-masking.ts",
        "src/gql/gql.ts",
        "src/gql/index.ts"
      ],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/ui": {
      "ignore": ["vitest.shims.d.ts"],
      "ignoreDependencies": [
        "@vitejs/plugin-react",
        "@storybook/test-runner",
        "eslint-plugin-storybook"
      ]
    }
  }
}
