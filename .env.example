# Copy to a root `.env` and/or split into `apps/*/` as needed for how you run the API and web.

# -----------------------------------------------------------------------------
# Docker Compose — `postgres` service
# -----------------------------------------------------------------------------
# Database role name inside the container
POSTGRES_USER=postgres

# Postgres user password (use a strong value outside local dev)
POSTGRES_PASSWORD=postgres

# Initial database name
POSTGRES_DB=job_tracker

# -----------------------------------------------------------------------------
# API — `apps/api` (`apps/api/src/env/server.ts`)
# -----------------------------------------------------------------------------
# PostgreSQL URL for TypeORM (`localhost` targets Postgres on host port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_tracker

# Node environment (development | test | production)
NODE_ENV=development

# Nest HTTP port (default 3101; keep 3100–3199 for local/test per schema)
PORT=3101

# Optional API Sentry DSN — omit entirely or set a valid URL (empty string fails Zod validation)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Google OAuth credentials (GCP project / consent screen)
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Google OAuth callback URL served by the API
GOOGLE_CALLBACK_URL=http://localhost:3101/auth/google/callback

# Secret for signing access JWTs (long random string in production)
JWT_ACCESS_SECRET=change-me-access

# Secret for signing refresh JWTs
JWT_REFRESH_SECRET=change-me-refresh

# Web app origin for post-login redirects (CORS / returnTo)
WEB_URL=http://localhost:3100

# Optional — Apollo GraphOS (Studio): publish schema from the API on startup
# APOLLO_KEY=
# APOLLO_GRAPH_REF=your-graph@current

# Optional — OpenAI API key for features wired in the API
OPENAI_API_KEY=

# OpenAI model when using AI features (schema default)
OPENAI_MODEL=gpt-4.1-mini

# Development only: skip interactive Google OAuth when hitting Google auth routes (see specs/024)
AUTH_BYPASS_ENABLED=false

# Bypass user email when AUTH_BYPASS_ENABLED=true
DEV_AUTH_BYPASS_EMAIL=richard.lopes92@gmail.com

# -----------------------------------------------------------------------------
# Web — `apps/web` (client / server env)
# -----------------------------------------------------------------------------
# Next.js dev server port (default 3100; set in `apps/web` if it conflicts with API PORT)
# PORT=3100

# API base URL — used by Apollo Client (GraphQL) and auth refresh; sets `getApiBaseUrl()`
NEXT_PUBLIC_API_URL=http://localhost:3101

# Optional — Sentry DSN for the client bundle — omit or use a valid URL
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# -----------------------------------------------------------------------------
# Playwright — `apps/web` (E2E)
# -----------------------------------------------------------------------------
# Port the test web server listens on (default 3100 in playwright.config)
# E2E_PORT=3100

# -----------------------------------------------------------------------------
# Chrome extension — WXT (`apps/extension`)
# -----------------------------------------------------------------------------
# API origin (GraphQL / auth cookies / SSE); also feeds MV3 `host_permissions` via `wxt.config.ts`
# WXT_PUBLIC_API_URL=http://localhost:3101

# Web app URL (sign-in / open tab); if unset in typical dev, inferred from API port 3101→3100
# WXT_PUBLIC_WEB_URL=http://localhost:3100

# -----------------------------------------------------------------------------
# Git worktree parallel dev (see `.env.worktree.example`)
# -----------------------------------------------------------------------------
# Run only inside `git worktree add` checkouts — never on the main checkout.
#   export WORKTREE_SOURCE_DB=job_tracker
#   pnpm worktree:env
#   pnpm pm2:start
# Teardown: pnpm worktree:teardown [--keep-db]
# Generated config: `.env.worktree` (gitignored). PM2 loads it via `ecosystem.config.cjs`.
