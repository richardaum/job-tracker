# Repository root — pnpm workspace, Turbo
node_modules/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/

# TypeScript (all workspaces)
*.tsbuildinfo

# Secrets — any workspace or root (typical in monorepos)
.env
.env.local
.env.*.local
.env.worktree

# apps/web — Next.js 16, Vitest, Playwright (e2e)
apps/web/.next/
apps/web/.next-dev/
apps/web/out/
apps/web/.rsdoctor/
apps/web/next-env.d.ts
apps/web/.vercel

# apps/api — NestJS (nest build → dist), Vitest
# (apps/web has no dist/; use apps/*/dist/ if a future app compiles to dist)

# packages/ui — tsc → dist/, Storybook static build
# packages/logger — no build script today; dist/ ignored for consistency

apps/*/coverage/
apps/*/dist/
apps/extension/build/
apps/extension/.wxt/
packages/*/coverage/
packages/*/dist/

# Playwright & Vitest browser — outputs live next to the package that runs tests
# (apps/web e2e, packages/ui Storybook + Vitest browser)
**/test-results/
**/playwright-report/
**/blob-report/

# Storybook — `build-storybook` default output (packages/ui)
storybook-static/

# Legacy: Storybook used to generate `docs/specs/` from LeanSpec; keep ignoring if the folder still exists locally
docs/specs/

# Logs & tool caches
logs/
*.log
.eslintcache
.prettiercache

# Editor / agent tooling — canonical skills/commands live under `.ai/` (pnpm setup-ai symlinks elsewhere)
.agents/*
!.agents/rules/
!.agents/skills/
.agents/skills/*
!.agents/skills/worktree-env/
!.agents/skills/worktree-loop/
.ai/skills/leanspec-development/
.ai/.skill-lock.json
.ai/.skill-lock.json.backup
.claude/
.cursor/
.gemini/
.windsurf/
.worktrees/

# OS
.DS_Store
Thumbs.db

# Vercel — root or linked app (web often uses apps/web)
.vercel

# Editor workspace files
*.code-workspace
.playwright-mcp/
