# Copy is not needed — run `pnpm worktree:env` inside a git worktree.
# This file documents variables written to `.env.worktree` (gitignored).

# Identity / PM2
WORKTREE_SLUG=my-feature
PM2_NAMESPACE=job-tracker-my-feature
PM2_APP_PREFIX=my-feature
PM2_RESET_PORTS=3105,3106,6007,3002

# Ports (per-app; ecosystem maps API_PORT/WEB_PORT → PORT)
API_PORT=3105
WEB_PORT=3106
STORYBOOK_PORT=6007
WXT_DEV_PORT=3002

# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_tracker_my_feature
# DATABASE_E2E_URL=postgresql://postgres:postgres@localhost:5432/job_tracker_test_my_feature
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3105/auth/google/callback
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
WEB_URL=http://localhost:3106
AUTH_BYPASS_ENABLED=true
DEV_AUTH_BYPASS_EMAIL=
NODE_ENV=development

# Web / extension public origins
NEXT_PUBLIC_API_URL=http://localhost:3105
WXT_PUBLIC_API_URL=http://localhost:3105
WXT_PUBLIC_WEB_URL=http://localhost:3106

# Setup input (not written to .env.worktree — export before worktree:env)
# WORKTREE_SOURCE_DB=job_tracker
# Optional: Postgres only in Docker / no host psql — auto-detects main-checkout compose
# WORKTREE_POSTGRES_DOCKER=job-tracker-postgres-1
# WORKTREE_POSTGRES_USER=postgres
