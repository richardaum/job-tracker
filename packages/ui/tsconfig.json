{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": { "@ui/*": ["./src/*"] }
  },
  "include": ["src/**/*", "vitest.setup.ts"],
  "exclude": ["node_modules", "dist"]
}
