# Copy to `.env.development` — WXT auto-loads this file at dev/build time.
# PM2 also reads it via `env_file` in `ecosystem.config.cjs`.

# WXT dev server port (default 3001)
WXT_DEV_PORT=3001

# API origin (GraphQL / auth / SSE)
WXT_PUBLIC_API_URL=http://localhost:3101

# Web app URL (sign-in / open tab)
WXT_PUBLIC_WEB_URL=http://localhost:3100

# Worktree parallel dev — see `.env.worktree.example` at repo root.
# `pnpm worktree:env` overwrites this file with worktree-specific ports/URLs.
