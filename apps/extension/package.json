{
  "name": "@job-tracker/extension",
  "displayName": "Job Tracker",
  "version": "0.0.1",
  "private": true,
  "description": "Job Tracker browser extension (MV3 / Plasmo scaffold).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-extension-host-permissions.mjs && plasmo dev",
    "icons": "node scripts/render-extension-icons.mjs",
    "build": "node scripts/render-extension-icons.mjs && node scripts/sync-extension-host-permissions.mjs && plasmo build",
    "package": "node scripts/render-extension-icons.mjs && node scripts/sync-extension-host-permissions.mjs && plasmo package",
    "lint": "eslint . --fix --max-warnings=0 --no-warn-ignored && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/extension-host-patterns.test.mjs"
  },
  "dependencies": {
    "@job-tracker/ui": "workspace:*",
    "clsx": "^2.1.1",
    "graphql-sse": "^2.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "jsdom": "^29.0.2",
    "plasmo": "^0.90.5",
    "postcss": "^8.5.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "manifest": {
    "name": "Job Tracker",
    "description": "Capture job listings into Job Tracker.",
    "permissions": [
      "cookies",
      "sidePanel",
      "scripting",
      "storage",
      "tabs"
    ],
    "host_permissions": [
      "http://127.0.0.1:3101/*",
      "http://127.0.0.1:7276/*",
      "http://localhost:3101/*",
      "https://remoteyeah.com/*"
    ]
  }
}
