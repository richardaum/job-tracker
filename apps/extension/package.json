{
  "name": "@job-tracker/extension",
  "displayName": "Job Tracker",
  "version": "0.0.3",
  "private": true,
  "description": "Job Tracker browser extension (MV3 / WXT + Vite).",
  "type": "module",
  "scripts": {
    "prepare": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "package": "wxt zip",
    "lint": "eslint . --fix --max-warnings=0 --no-warn-ignored && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@job-tracker/ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "postcss": "^8.5.10",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "wxt": "^0.20.25"
  }
}
