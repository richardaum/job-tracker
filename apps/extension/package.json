{
  "name": "@job-tracker/extension",
  "displayName": "Job Tracker",
  "version": "0.0.1",
  "private": true,
  "description": "Job Tracker browser extension (MV3 / Plasmo scaffold).",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "icons": "node scripts/render-extension-icons.mjs",
    "build": "node scripts/render-extension-icons.mjs && plasmo build",
    "package": "node scripts/render-extension-icons.mjs && plasmo package",
    "lint": "eslint . --fix --max-warnings=0 --no-warn-ignored && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "plasmo": "^0.90.5",
    "sharp": "^0.33.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "manifest": {
    "name": "Job Tracker",
    "description": "Capture job listings into Job Tracker (browser extension scaffold).",
    "permissions": [
      "sidePanel"
    ]
  }
}
