# Copy to `apps/web/.env` — gitignored, holds real values.
# PM2 loads this file via `env_file` in `ecosystem.config.cjs`.

# Node environment (development | test | production)
NODE_ENV=development

# Next.js dev server port (default 3100; must be 3100–3199 for local/test)
PORT=3100

# API base URL — used by Apollo Client (GraphQL) and auth refresh
NEXT_PUBLIC_API_URL=http://localhost:3101

# Optional — Sentry DSN for the client bundle
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# PostHog — project API key for the browser client (posthog-js)
# NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host (default: US cloud; use https://eu.i.posthog.com for EU cloud)
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog — personal API key (feature_flags:read scope), only if evaluating flags server-side (middleware/RSC)
# POSTHOG_PERSONAL_API_KEY=

# Opt-in for deterministic landing-page screenshot capture sessions (hides the Admin sidebar
# item and the Next dev indicator). Leave unset/false for normal development.
# NEXT_PUBLIC_SCREENSHOTS_ENABLED=false

# Worktree parallel dev — see `.env.worktree.example` at repo root.
# Run `pnpm worktree:env` inside a `git worktree add` checkout.
# PM2 loads overrides via `ecosystem.config.cjs` `env` block.
