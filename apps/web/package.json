{
  "name": "@job-tracker/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${PORT:-3100}",
    "build": "next build",
    "start": "next start --port ${PORT:-3100}",
    "codegen": "graphql-codegen --config codegen.ts && node ./scripts/postprocess-codegen-hooks.mjs",
    "lint": "eslint . --max-warnings=0 && tsc --noEmit",
