# Copy to `apps/api/.env` — gitignored, holds real values.
# PM2 loads this file via `env_file` in `ecosystem.config.cjs`.

# PostgreSQL URL for TypeORM
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_tracker

# Integration test database URL (required for `*.integration.ts` / migration integration specs)
DATABASE_INTEGRATION_URL=postgresql://postgres:postgres@localhost:5432/job_tracker_test

# Node environment (development | test | production)
NODE_ENV=development

# Nest HTTP port (default 3101; keep 3100–3199 for local/test per schema)
PORT=3101

# Reverse-proxy hops for correct client IP (in-app rate limiting until WAF is live). Set to 1 in production behind one proxy.
TRUST_PROXY_HOPS=0

# Optional — Sentry DSN for the API
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Google OAuth credentials (GCP project / consent screen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth callback URL served by the API
GOOGLE_CALLBACK_URL=http://localhost:3101/auth/google/callback

# Secret for signing access JWTs (long random string in production)
JWT_ACCESS_SECRET=change-me-access

# Optional — multi-secret rotation for access JWTs (JSON; takes precedence over JWT_ACCESS_SECRET)
# JWT_ACCESS_SECRETS={"current":"new-access-secret","previous":"old-access-secret"}

# Secret for signing refresh JWTs
JWT_REFRESH_SECRET=change-me-refresh

# Optional — multi-secret rotation for refresh JWTs (JSON; takes precedence over JWT_REFRESH_SECRET)
# JWT_REFRESH_SECRETS={"current":"new-refresh-secret","previous":"old-refresh-secret"}

# Web app origin for post-login redirects (CORS / returnTo)
WEB_URL=http://localhost:3100

# Optional — OpenAI API key for AI features
# OPENAI_API_KEY=

# OpenAI model when using AI features (default: gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# Development only: skip interactive Google OAuth
AUTH_BYPASS_ENABLED=false

# Required when AUTH_BYPASS_ENABLED=true — must match an existing user email
DEV_AUTH_BYPASS_EMAIL=richard.lopes92@gmail.com

# Dev/E2E only — disable in-app auth throttling and SSE IP limits (never in production)
# RATE_LIMIT_DISABLED=true

# Worktree parallel dev — see `.env.worktree.example` at repo root.
# Run `pnpm worktree:env` inside a `git worktree add` checkout.
# PM2 loads overrides via `ecosystem.config.cjs` `env` block.
