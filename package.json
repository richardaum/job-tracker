{
  "name": "job-tracker",
  "private": true,
  "scripts": {
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reset": "node scripts/pm2-ecosystem-reset.mjs",
    "ports:kill": "node scripts/kill-tcp-listen-ports.mjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "dev": "turbo run dev db:migrate:watch",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage --coverage.thresholds.lines=80",
    "ci:local": "pnpm leanspec:validate && pnpm leanspec:sync-spec-indices -- --check && pnpm turbo lint && pnpm turbo typecheck && pnpm turbo test -- --coverage --coverage.thresholds.lines=80 && pnpm turbo build",
    "e2e": "pnpm turbo build --filter=@job-tracker/web && pnpm --filter @job-tracker/web run e2e",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "typecheck:repo": "tsc -p tsconfig.repo.json --noEmit",
    "leanspec:validate": "pnpm exec lean-spec validate",
    "leanspec:sync-spec-indices": "node scripts/sync-spec-indices.mjs",
    "storybook:sync-specs": "node scripts/generate-specs-storybook.mjs",
    "setup-ai": "node scripts/setup-ai-symlinks.mjs",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t job-tracker-api:local .",
    "perf:rsdoctor:dev": "pnpm --filter @job-tracker/web run dev:rsdoctor"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "16.3.0-canary.6",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lean-spec": "^0.2.28",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.2",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@apollo/server": "5"
      }
    }
  }
}
